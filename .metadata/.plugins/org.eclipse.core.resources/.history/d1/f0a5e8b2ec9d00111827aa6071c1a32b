import java.io.*;
public class Exception {
	public static void main(String[] args) {
File f = new File("text.txt");
try {
	FileReader fr = new FileReader(f);
}
catch(FileNotFoundException e){
	e.printStackTrace();
	System.out.println("not readable");
}finally {
	System.out.println("Executed");
}
}
}
