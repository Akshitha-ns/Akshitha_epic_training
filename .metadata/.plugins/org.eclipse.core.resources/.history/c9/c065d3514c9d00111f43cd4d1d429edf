package epic_training;
class EmployeData{
	String name;
	EmployeData(String name){
		this.name=name;
	}
}
abstract  class PaymentType extends EmployeeData{
	int salary;
	PaymentType(String name,int salary){
		super(name);
		this.salary=salary;
	}
}
public class Thiskey {
	public static void main(String[] args) {
		PaymentType pay = new PaymentType("akshi",15000);
		System.out.println(pay.name);
	}
}
